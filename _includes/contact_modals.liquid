<!-- filepath: c:\AcademicPage\_includes\contact_modals.liquid -->
<!-- 邮箱模态框 -->
<div id="email-modal" class="contact-modal-overlay" style="display: none;">
  <div class="contact-modal-box">
    <div class="contact-modal-header">
      <h3 class="contact-modal-title">Email</h3>
      <div class="header-actions">
        <button class="copy-button" data-email="yhy520@email.swu.edu.cn" title="Copy Email">
          <i class="fa fa-copy"></i> Copy
        </button>
        <button class="contact-modal-close" onclick="closeEmailModal()">&times;</button>
      </div>
    </div>
    <div class="contact-modal-body">
      <div class="image-wrapper">
        <img src="{{ site.contact_info.email_qr | relative_url }}" alt="Email QR Code" class="contact-qrcode">
      </div>
    </div>
  </div>
</div>

