
<!-- Custom Styles from _sass/_custom.scss Inlined for Safety -->
<style>
@font-face {
  font-family: 'ZhiMangXingNameSubset';
  src: url('{{ "/assets/fonts/ZhiMangXing-name-subset.woff2" | relative_url }}') format('woff2');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
  unicode-range: U+6768, U+5F18, U+6BC5;
}

@font-face {
  font-family: "AboutBodyNumerals";
  src: local("Times New Roman");
  font-weight: 400;
  font-style: normal;
  unicode-range: U+0030-0039;
}

.name-calligraphy {
  font-family: 'ZhiMangXingNameSubset', 'STXingkai', 'KaiTi', 'Kaiti SC', cursive;
  font-weight: 400;
  display: inline-block;
  margin-right: -0.36rem;
  margin-left: -0.18rem;
  transform: translateY(0.08em);
  vertical-align: baseline;
}

.about-body {
  font-family: "AboutBodyNumerals", "Merriweather", "Georgia", serif;
}

.about-body p,
.about-body li {
  text-align: justify;
  text-justify: inter-word;
  text-align-last: auto;
  -webkit-hyphens: auto;
  -ms-hyphens: auto;
  hyphens: auto;
  overflow-wrap: normal;
  word-break: normal;
  line-break: auto;
}

.about-body strong,
.about-body b {
  font-size: inherit;
  font-family: "Times New Roman", "Georgia", serif;
  color: #000;
  font-weight: 700;
}

.about-body h4 {
  font-size: inherit;
  font-weight: 700;
  font-family: "Times New Roman", "Georgia", serif;
  color: #000;
}

.homepage-section-heading {
  font-family: "Merriweather", "Georgia", serif;
}

/* Stat Cards */
.stat-cards-container {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin: 22px 0;
  justify-content: center;
}

.stat-card {
  --stat-card-accent: var(--global-theme-color);
  --stat-card-bg: color-mix(in srgb, var(--stat-card-accent) 11%, var(--global-card-bg-color));
  --stat-card-border: color-mix(in srgb, var(--stat-card-accent) 26%, var(--global-divider-color));
  --stat-card-value-color: color-mix(in srgb, var(--stat-card-accent) 74%, var(--global-text-color));
  background: var(--stat-card-bg);
  border: 1px solid var(--stat-card-border);
  color: var(--global-text-color);
  padding: 1.05rem 1rem;
  border-radius: 8px;
  text-align: center;
  display: grid;
  align-content: center;
  justify-items: center;
  gap: 0.35rem;
  overflow: hidden;
  min-width: 0;
  min-width: 130px;
  min-height: 122px;
  container-type: inline-size;
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.05);
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  flex: 1 1 calc(50% - 15px); /* Default to 2 columns */
  max-width: calc(50% - 5px);
}

@media (min-width: 768px) {
  .stat-card {
    flex: 1 1 calc(25% - 15px); /* 4 columns on desktop */
    max-width: none;
  }
}

/* Mobile Profile Fix */
@media (max-width: 768px) {
  .profile.float-right, .profile.float-left {
    float: none !important;
    width: 100% !important;
    margin: 0 auto 20px auto;
    text-align: center;
  }
  .profile.float-right img, .profile.float-left img {
      max-width: 200px;
      margin: 0 auto;
  }
  /* Fix stat cards container flex on mobile if needed */
  .stat-cards-container {
      justify-content: space-between; /* Better spacing for 2x2 */
  }
}

/* Contact Note Badges Fix */
.contact-note span {
  display: inline-block !important;
  margin: 5px !important;
}

.stat-card:hover {
  transform: translateY(-2px);
  border-color: color-mix(in srgb, var(--stat-card-accent) 42%, var(--global-divider-color));
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.09);
}

.stat-card .stat-value {
  color: var(--stat-card-value-color);
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  font-size: 1.65rem;
  font-size: clamp(1.35rem, 15cqw, 1.85rem);
  font-weight: 750;
  line-height: 1.1;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: clip;
}

.stat-card .stat-value-wide {
  font-size: 1.25rem;
  font-size: clamp(1.2rem, 12cqw, 1.62rem);
}

.stat-card .stat-label {
  width: 100%;
  max-width: 100%;
  color: var(--global-text-color-light);
  font-size: 0.92rem;
  letter-spacing: 0;
  margin-top: 0;
}

.stat-card-blue { --stat-card-accent: #5b75d6; }
.stat-card-pink { --stat-card-accent: #d35f9f; }
.stat-card-cyan { --stat-card-accent: #2f9cc5; }
.stat-card-green { --stat-card-accent: #36a875; }

html[data-theme="dark"] .stat-card {
  --stat-card-bg: color-mix(in srgb, var(--stat-card-accent) 18%, var(--global-card-bg-color));
  --stat-card-border: color-mix(in srgb, var(--stat-card-accent) 38%, var(--global-divider-color));
  --stat-card-value-color: color-mix(in srgb, var(--stat-card-accent) 70%, #ffffff);
  box-shadow: 0 10px 26px rgba(0, 0, 0, 0.18);
}

/* Language Switcher */
.lang-switcher-header {
  margin-bottom: 2rem;
}
.lang-switcher-header a {
  transition: color 0.2s ease;
}
.lang-switcher-header a:hover {
  text-decoration: underline;
}

/* Profile Info in Header */
.profile-info-card {
  display: grid;
  gap: 0.55rem;
  margin-top: 0.75rem;
  padding: 0.75rem;
  border: 1px solid color-mix(in srgb, var(--global-theme-color) 18%, var(--global-divider-color));
  border-radius: 8px;
  background: color-mix(in srgb, var(--global-theme-color) 5%, var(--global-card-bg-color));
  color: var(--global-text-color);
  font-family: 'SF Pro Display', 'Helvetica Neue', 'Arial', sans-serif;
}
.profile-info-item {
  display: grid;
  grid-template-columns: 1.9rem minmax(0, 1fr);
  align-items: center;
  gap: 0.55rem;
  font-size: 0.92rem;
  font-weight: 650;
  line-height: 1.25;
}
.profile-info-icon {
  display: inline-grid;
  width: 1.75rem;
  height: 1.75rem;
  place-items: center;
  border-radius: 6px;
  background: color-mix(in srgb, var(--global-theme-color) 12%, var(--global-bg-color));
  font-size: 0.95rem;
}
html[data-theme="dark"] .profile-info-card {
  border-color: color-mix(in srgb, var(--global-theme-color) 28%, var(--global-divider-color));
  background: color-mix(in srgb, var(--global-theme-color) 9%, var(--global-card-bg-color));
}
html[data-theme="dark"] .profile-info-icon {
  background: color-mix(in srgb, var(--global-theme-color) 16%, var(--global-bg-color));
}
</style>
