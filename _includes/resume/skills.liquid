<div class="list-groups resume-skill-groups">
  {% for content in data[1] %}
    <section class="resume-list-card list-group col-md-6" title="{{ content.level }}">
      <div class="resume-list-card-heading">
        {% if content.icon %}
          <i class="{{ content.icon }}"></i>
        {% endif %}
        <span>{{ content.name }}</span>
      </div>
      <div class="resume-keyword-list">
        {% for item in content.keywords %}
          {% assign skill_parts = item | split: ' (' %}
          {% if skill_parts.size > 1 %}
            <span class="resume-keyword resume-keyword-with-level">
              <span class="resume-keyword-name">{{ skill_parts[0] }}</span>
              <span class="resume-keyword-level">({{ skill_parts[1] }}</span>
            </span>
          {% else %}
            <span class="resume-keyword">{{ item }}</span>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endfor %}
</div>
