<div class="list-groups resume-language-groups">
  {% for content in data[1] %}
    <section class="resume-language-card">
      <div class="resume-language-name">
        {% if content.icon %}
          <i class="{{ content.icon }}"></i>
        {% endif %}
        <span>{{ content.language }}</span>
      </div>
      <div class="resume-language-fluency">{{ content.fluency }}</div>
    </section>
  {% endfor %}
</div>
