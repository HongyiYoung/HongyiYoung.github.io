@inproceedings{yang2025leaderline,
  abbr={VIS},
  title={Aesthetic-Driven Leader-Line Generation for Label Placement},
  author={Yang*, Hongyi and Qu, Jingwei},
  abstract={In view management, mainstream works focus on label placement while overlooking the aesthetic quality of leader lines as visual bridges. This work addresses leader-line layout generation in complex scenes by proposing a deep reinforcement learning-based framework. We model the generation process as a Markov Decision Process (MDP) and develop a Leader-Line Agent (LeLA) using Maskable PPO. By designing comprehensive state vectors incorporating congestion and conflict risk features, and translating complex aesthetic rules into cost functions, combined with a Style Unification Algorithm for refinement, our model effectively minimizes crossings. Experiments on the SWU-AMIL dataset show a 57.1% reduction in Aesthetic Arrangement Cost and a drop in occlusion rate to 0.57%. User studies further confirm that our method significantly lowers mental load and improves information retrieval accuracy (82.7%).},
  year={2025},
  note={Under review at IEEE VIS (CCF-A)},
  bibtex_show={true},
  selected={true},
  preview={},
  pdf={_CVPR_26___Aesthetic_Driven_Leader_Line_Generation_for_Label_Placement (14).pdf}
}