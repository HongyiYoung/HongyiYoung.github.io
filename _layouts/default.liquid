<!-- filepath: c:\AcademicPage\_layouts\default.liquid -->
<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
          </div>
        {% else %}
          <div class="row">
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}

    <!-- 联系方式模态框 -->
    {% include contact_modals.liquid %}

<!-- 联系方式JavaScript -->
<script>
// 邮箱模态框功能
function openEmailModal(event) {
  if (event) {
    event.preventDefault();
    event.stopPropagation();
  }
  closeAllModals();
  const modal = document.getElementById('email-modal');
  if (modal) {
    modal.style.display = 'flex';
  }
}

function closeEmailModal() {
  const modal = document.getElementById('email-modal');
  if (modal) {
    modal.style.display = 'none';
  }
}

// 微信模态框功能
function openWeChatModal(event) {
  if (event) {
    event.preventDefault();
    event.stopPropagation();
  }
  closeAllModals();
  const modal = document.getElementById('wechat-modal');
  if (modal) {
    modal.style.display = 'flex';
  }
}

function closeWeChatModal() {
  const modal = document.getElementById('wechat-modal');
  if (modal) {
    modal.style.display = 'none';
  }
}

// QQ模态框功能
function openQQModal(event) {
  if (event) {
    event.preventDefault();
    event.stopPropagation();
  }
  closeAllModals();
  const modal = document.getElementById('qq-modal');
  if (modal) {
    modal.style.display = 'flex';
  }
}

function closeQQModal() {
  const modal = document.getElementById('qq-modal');
  if (modal) {
    modal.style.display = 'none';
  }
}

// 关闭所有模态框
function closeAllModals() {
  const modals = ['email-modal', 'wechat-modal', 'qq-modal'];
  modals.forEach(modalId => {
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.style.display = 'none';
    }
  });
}

// 初始化功能
document.addEventListener('DOMContentLoaded', function() {
  // 复制邮箱功能
  const copyButton = document.querySelector('.copy-button');
  if (copyButton) {
    copyButton.addEventListener('click', function() {
      const email = this.getAttribute('data-email');
      navigator.clipboard.writeText(email).then(function() {
        const originalText = copyButton.innerHTML;
        copyButton.innerHTML = '<i class="fa fa-check"></i> Copied!';
        setTimeout(() => {
          copyButton.innerHTML = originalText;
        }, 2000);
      });
    });
  }
  
  // 点击模态框外部关闭
  document.querySelectorAll('.contact-modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', function(e) {
      if (e.target === this) {
        closeAllModals();
      }
    });
  });
  
  // ESC键关闭模态框
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeAllModals();
    }
  });
});
</script>

<!-- 在 JavaScript 代码后面添加以下 CSS 样式 -->

<!-- 联系方式CSS样式 -->
<style>
.contact-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.contact-modal-box {
  background: white;
  border-radius: 12px;
  max-width: 400px;
  width: 90%;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  overflow: hidden;
}

.contact-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  background: #f8f9fa;
  border-bottom: 1px solid #dee2e6;
}

.contact-modal-title {
  font-size: 1.2rem;
  font-weight: 600;
  color: #333;
}

.header-actions {
  display: flex;
  gap: 10px;
}

.copy-button, .contact-modal-close {
  background: none;
  border: none;
  padding: 5px 10px;
  cursor: pointer;
  border-radius: 6px;
  transition: background-color 0.2s;
}

.copy-button:hover {
  background-color: #007bff;
  color: white;
}

.contact-modal-close {
  font-size: 1.5rem;
  color: #6c757d;
}

.contact-modal-close:hover {
  background-color: #dc3545;
  color: white;
}

.contact-modal-body {
  padding: 20px;
  text-align: center;
}

.contact-qrcode {
  max-width: 200px;
  width: 100%;
  height: auto;
  border-radius: 8px;
  margin-bottom: 10px;
}

.contact-text {
  margin-bottom: 15px;
}

.contact-text p {
  font-family: monospace;
  background: #f8f9fa;
  padding: 10px;
  border-radius: 6px;
  margin: 0;
}

.contact-tip {
  color: #6c757d;
  font-size: 0.9rem;
  margin: 10px 0 0 0;
}

.image-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
}

/* 深色模式支持 */
html[data-theme="dark"] .contact-modal-box {
  background: #2d3748;
  color: #e2e8f0;
}

html[data-theme="dark"] .contact-modal-header {
  background: #4a5568;
  border-bottom-color: #718096;
}

html[data-theme="dark"] .contact-modal-title {
  color: #e2e8f0;
}

html[data-theme="dark"] .contact-text p {
  background: #4a5568;
  color: #e2e8f0;
}

html[data-theme="dark"] .contact-modal-close {
  color: #a0aec0;
}

html[data-theme="dark"] .contact-modal-close:hover {
  background-color: #dc3545;
  color: white;
}

html[data-theme="dark"] .copy-button:hover {
  background-color: #007bff;
  color: white;
}

/* 响应式设计 */
@media (max-width: 768px) {
  .contact-modal-box {
    max-width: 95%;
    margin: 10px;
  }
  
  .contact-modal-header {
    padding: 15px;
  }
  
  .contact-modal-body {
    padding: 15px;
  }
  
  .contact-qrcode {
    max-width: 180px;
  }
}
</style>

  </body>
</html>